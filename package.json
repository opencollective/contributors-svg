{
  "name": "contributors-svg",
  "version": "2.2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/opencollective/contributors-svg.git"
  },
  "private": true,
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "dependencies": {
    "@apollo/client": "3.14.1",
    "@hyperwatch/hyperwatch": "5.3.0",
    "@octokit/auth-oauth-app": "9.0.5",
    "@octokit/rest": "22.0.1",
    "bluebird": "3.7.2",
    "cached-request": "3.0.0",
    "debug": "^4.3.4",
    "dotenv": "^18.0.0",
    "express": "^5.0.0",
    "express-basic-auth": "1.2.1",
    "express-winston": "4.2.0",
    "graphql": "16.14.2",
    "graphql-tag": "^2.12.6",
    "image-size": "2.0.4",
    "lodash": "4.18.1",
    "lru-cache": "11.5.3",
    "mime-types": "3.0.2",
    "node-fetch": "2.7.0",
    "p-limit": "3.1.0",
    "p-queue": "9.3.3",
    "redis": "3.1.2",
    "request": "2.88.2",
    "sharp": "0.35.5",
    "winston": "^3.17.0"
  },
  "scripts": {
    "start": "NODE_ENV=production node dist/server",
    "dev": "nodemon --exec babel-node -- src/server/index.js",
    "build": "npm run build:clean && npm run build:server",
    "build:clean": "rm -rf dist",
    "build:server": "babel --copy-files src --out-dir dist",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
    "lint:quiet": "npm run lint -- --quiet",
    "pretest": "npm run lint:quiet && npm run prettier:check",
    "prettier": "prettier \"src/**/*.js\" \"test/**/*.js\"",
    "prettier:write": "npm run prettier -- --write",
    "prettier:check": "npm run prettier -- --list-different",
    "deploy:production": "./scripts/pre-deploy.sh production && git push production main",
    "graphql:update": "npm run graphql:updateV1 && npm run graphql:updateV2",
    "graphql:updateV1": "npx get-graphql-schema http://localhost:3060/graphql > src/graphql/schema.graphql && prettier src/graphql/schema.graphql --write",
    "graphql:updateV2": "npx get-graphql-schema http://localhost:3060/graphql/v2 > src/graphql/schemaV2.graphql && prettier src/graphql/schemaV2.graphql --write",
    "test": "node --test \"test/**/*.test.js\"",
    "prepare": "husky",
    "lint-staged": "lint-staged"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.0",
    "@babel/core": "^8.0.0",
    "@babel/node": "^8.0.0",
    "@babel/preset-env": "^8.0.0",
    "@babel/register": "^8.0.6",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.12.0",
    "eslint-config-opencollective": "^7.1.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^18.4.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "nodemon": "^3.0.0",
    "prettier": "^3.4.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  },
  "nodemonConfig": {
    "watch": [
      "src/server"
    ]
  },
  "lint-staged": {
    "*.js": [
      "prettier --write"
    ]
  }
}
